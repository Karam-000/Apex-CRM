# Apex CRM — environment configuration
# Copy this file to ".env" (same directory you run uvicorn from) and fill in values.
# The app loads .env automatically on startup (via python-dotenv).

# --- SMTP / outbound email (used by the "Compose Email" feature) ---
# If these are left blank, emails are NOT sent — they are logged as drafts
# (status "dry_run") so the app still works locally without a mail server.

SMTP_HOST=smtp.gmail.com        # e.g. smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net
SMTP_PORT=587                   # 587 for STARTTLS (recommended)
SMTP_USER=you@example.com       # SMTP username (often your email address)
SMTP_PASSWORD=your-app-password # SMTP password or provider API/app password
SMTP_FROM=you@example.com       # "From" address (defaults to SMTP_USER if blank)
SMTP_USE_TLS=true               # use STARTTLS (true/false)

# --- Authentication (JWT) ---
# Secret used to sign login tokens. MUST be set to a long random value in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480          # access-token lifetime in minutes (default 8h)
